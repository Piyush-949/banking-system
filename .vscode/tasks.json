{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build RBI Banking System",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "*.cpp",
                "-o",
                "rbi_banking_system.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}